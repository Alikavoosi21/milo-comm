# Safe template only. Copy to .env and add your private values locally.
# Never commit .env or paste real API keys into this file.

AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4.1-mini
AI_TIMEOUT_MS=30000
MOCK_AI=true

# local for development, pgvector for PostgreSQL-backed deployments
RAG_STORAGE_MODE=local
DATABASE_URL=
STORAGE_DIR=.data/uploads

# Optional external embeddings and reranker. Keep keys empty in this template.
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
RERANK_API_KEY=
RERANK_MODEL=rerank-v4.0-fast

RAG_CANDIDATES=12
RAG_MIN_SCORE=0.35
MEMORY_ACTIVE_TOKEN_LIMIT=12000
MEMORY_SUMMARY_TOKEN_LIMIT=1000
MEMORY_RECENT_MESSAGES=8

# Set a private admin password and generate a unique session secret before deployment.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Optional cost configuration
AI_INPUT_COST_PER_MILLION=
AI_OUTPUT_COST_PER_MILLION=
EMBEDDING_COST_PER_MILLION=
RERANK_COST_PER_THOUSAND=
COST_CURRENCY=USD

# Optional web provider configuration (the chatbot answers from registered sources only).
WEB_SEARCH_URL=https://api.avalai.ir/v1/search/tavily-search
WEB_SEARCH_API_KEY=
WEB_SEARCH_COST_PER_QUERY=
